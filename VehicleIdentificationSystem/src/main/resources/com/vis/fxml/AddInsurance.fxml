<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vis.controller.EditInsuranceController"
      spacing="15" styleClass="root-pane"
      prefWidth="550" prefHeight="620">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Edit Insurance Policy" styleClass="section-title"/>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <GridPane hgap="10" vgap="12">

            <Label text="Insurance ID" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="insuranceIdField" editable="false"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Vehicle ID" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="vehicleIdField" editable="false"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Registration Number" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="regNumberField" editable="false"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Vehicle Details" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="vehicleDetailsField" editable="false"
                       GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Insurance Provider" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
            <ComboBox fx:id="providerCombo" GridPane.rowIndex="4" GridPane.columnIndex="1"
                      prefWidth="300" styleClass="combo-vis"/>

            <Label text="Policy Number" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="policyField" promptText="Policy Number"
                       GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Start Date" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="field-label"/>
            <DatePicker fx:id="startDatePicker" GridPane.rowIndex="6" GridPane.columnIndex="1"
                        prefWidth="300" promptText="Select start date" styleClass="date-picker-vis"/>

            <Label text="Expiry Date" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="field-label"/>
            <DatePicker fx:id="expiryDatePicker" GridPane.rowIndex="7" GridPane.columnIndex="1"
                        prefWidth="300" promptText="Select expiry date" styleClass="date-picker-vis"/>

            <Label text="Coverage Type" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="field-label"/>
            <ComboBox fx:id="coverageCombo" GridPane.rowIndex="8" GridPane.columnIndex="1"
                      prefWidth="300" styleClass="combo-vis"/>

            <Label text="Coverage Amount (M)" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="coverageAmountField" promptText="Coverage Amount"
                       GridPane.rowIndex="9" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Premium (M)" GridPane.rowIndex="10" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="premiumField" promptText="Premium"
                       GridPane.rowIndex="10" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Status" GridPane.rowIndex="11" GridPane.columnIndex="0" styleClass="field-label"/>
            <ComboBox fx:id="statusCombo" GridPane.rowIndex="11" GridPane.columnIndex="1"
                      prefWidth="300" styleClass="combo-vis"/>
        </GridPane>
    </ScrollPane>

    <Label fx:id="errorLabel" text="" styleClass="error-label"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-btn"/>
        <Button text="Update Insurance" onAction="#handleSave" styleClass="primary-btn"/>
    </HBox>
</VBox>