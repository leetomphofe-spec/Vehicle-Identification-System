<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vis.controller.DashboardController"
            prefWidth="1100" prefHeight="700"
            styleClass="root-pane">

    <!-- ===== MENU BAR ===== -->
    <top>
        <VBox>
            <MenuBar styleClass="menu-bar">
                <Menu text="File">
                    <MenuItem text="Dashboard" onAction="#showDashboard"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </Menu>
                <Menu text="Vehicles">
                    <MenuItem text="All Vehicles"  onAction="#showVehicles"/>
                    <MenuItem text="Add Vehicle"   onAction="#showAddVehicle"/>
                    <MenuItem text="Search Vehicle" onAction="#showSearch"/>
                </Menu>
                <Menu text="Modules">
                    <MenuItem text="Workshop"  onAction="#showWorkshop"/>
                    <MenuItem text="Police"    onAction="#showPolice"/>
                    <MenuItem text="Customers" onAction="#showCustomers"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="About" onAction="#showAbout"/>
                </Menu>
            </MenuBar>

            <!-- Header Bar -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
                <Label text="🚗 VIS" styleClass="header-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Welcome, Admin" styleClass="welcome-label"/>
                <Button text="Logout" onAction="#handleLogout" styleClass="logout-btn"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <TabPane fx:id="mainTabPane" styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE">

            <!-- Dashboard Tab -->
            <Tab text="Dashboard" fx:id="dashboardTab">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                    <VBox spacing="20" styleClass="dashboard-content">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="System Overview" styleClass="section-title"/>

                        <HBox spacing="20">
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <Label text="Total Vehicles" styleClass="stat-label"/>
                                <Label fx:id="totalVehiclesLabel" text="0" styleClass="stat-value"/>
                            </VBox>
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <Label text="Customers" styleClass="stat-label"/>
                                <Label fx:id="totalCustomersLabel" text="0" styleClass="stat-value"/>
                            </VBox>
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <Label text="Police Reports" styleClass="stat-label"/>
                                <Label fx:id="totalReportsLabel" text="0" styleClass="stat-value"/>
                            </VBox>
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <Label text="Violations" styleClass="stat-label"/>
                                <Label fx:id="totalViolationsLabel" text="0" styleClass="stat-value"/>
                            </VBox>
                        </HBox>

                        <!-- Progress Indicators -->
                        <Label text="System Progress Indicators" styleClass="section-title"/>
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <VBox spacing="5">
                                <Label text="Database Sync" styleClass="field-label"/>
                                <ProgressBar fx:id="progressBar" progress="0.75" prefWidth="250" styleClass="progress-bar-vis"/>
                            </VBox>
                            <VBox spacing="5" alignment="CENTER">
                                <Label text="Loading" styleClass="field-label"/>
                                <ProgressIndicator fx:id="progressIndicator" progress="-1" prefWidth="50"/>
                            </VBox>
                        </HBox>

                        <!-- Scroll Pane with 20+ items -->
                        <Label text="Recent Activity Log" styleClass="section-title"/>
                        <ScrollPane prefHeight="200" styleClass="inner-scroll">
                            <VBox fx:id="activityLogBox" spacing="5" styleClass="activity-log">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                            </VBox>
                        </ScrollPane>

                        <!-- Pagination -->
                        <Pagination fx:id="pagination" pageCount="5" currentPageIndex="0"
                                    maxPageIndicatorCount="5" styleClass="pagination-vis"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- Vehicles Tab -->
            <Tab text="Vehicles" fx:id="vehiclesTab">
                <VBox spacing="10" styleClass="tab-content">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <Label text="Vehicle Registry" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchRegField" promptText="Search by Registration..." prefWidth="250" styleClass="text-field-vis"/>
                        <Button fx:id="searchBtn" text="Search" onAction="#handleSearchVehicle" styleClass="secondary-btn"/>
                        <Button fx:id="refreshVehiclesBtn" text="Refresh" onAction="#refreshVehicles" styleClass="secondary-btn"/>
                        <Button fx:id="addVehicleBtn" text="+ Add Vehicle" onAction="#openAddVehicleDialog" styleClass="primary-btn"/>
                        <Button fx:id="deleteVehicleBtn" text="Delete" onAction="#handleDeleteVehicle" styleClass="danger-btn"/>
                    </HBox>
                    <TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS" styleClass="table-view-vis">
                        <columns>
                            <TableColumn fx:id="vIdCol"      text="ID"           prefWidth="50"/>
                            <TableColumn fx:id="vRegCol"     text="Reg. Number"  prefWidth="130"/>
                            <TableColumn fx:id="vMakeCol"    text="Make"         prefWidth="100"/>
                            <TableColumn fx:id="vModelCol"   text="Model"        prefWidth="100"/>
                            <TableColumn fx:id="vYearCol"    text="Year"         prefWidth="70"/>
                            <TableColumn fx:id="vOwnerCol"   text="Owner"        prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Workshop Tab -->
            <Tab text="Workshop" fx:id="workshopTab">
                <VBox spacing="10" styleClass="tab-content">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <Label text="Workshop — Service Records" styleClass="section-title"/>
                    <HBox spacing="10">
                        <Button text="Refresh" onAction="#refreshServiceRecords" styleClass="secondary-btn"/>
                        <Button text="+ Add Service Record" onAction="#openAddServiceDialog" styleClass="primary-btn"/>
                        <Button text="Delete" onAction="#handleDeleteService" styleClass="danger-btn"/>
                    </HBox>
                    <TableView fx:id="serviceTable" VBox.vgrow="ALWAYS" styleClass="table-view-vis">
                        <columns>
                            <TableColumn fx:id="sIdCol"      text="ID"           prefWidth="50"/>
                            <TableColumn fx:id="sRegCol"     text="Registration"  prefWidth="130"/>
                            <TableColumn fx:id="sDateCol"    text="Service Date"  prefWidth="120"/>
                            <TableColumn fx:id="sTypeCol"    text="Type"          prefWidth="120"/>
                            <TableColumn fx:id="sDescCol"    text="Description"   prefWidth="200"/>
                            <TableColumn fx:id="sCostCol"    text="Cost (M)"      prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Police Tab -->
            <Tab text="Police" fx:id="policeTab">
                <VBox spacing="10" styleClass="tab-content">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <Label text="Police Module" styleClass="section-title"/>
                    <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="inner-tabs">
                        <Tab text="Reports">
                            <VBox spacing="10" styleClass="tab-content">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <HBox spacing="10">
                                    <Button text="Refresh" onAction="#refreshPoliceReports" styleClass="secondary-btn"/>
                                    <Button text="+ Add Report" onAction="#openAddReportDialog" styleClass="primary-btn"/>
                                </HBox>
                                <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="table-view-vis">
                                    <columns>
                                        <TableColumn fx:id="prIdCol"     text="ID"          prefWidth="50"/>
                                        <TableColumn fx:id="prRegCol"    text="Reg. Number" prefWidth="130"/>
                                        <TableColumn fx:id="prDateCol"   text="Date"        prefWidth="110"/>
                                        <TableColumn fx:id="prTypeCol"   text="Type"        prefWidth="100"/>
                                        <TableColumn fx:id="prDescCol"   text="Description" prefWidth="200"/>
                                        <TableColumn fx:id="prOfficerCol" text="Officer"    prefWidth="130"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </Tab>
                        <Tab text="Violations">
                            <VBox spacing="10" styleClass="tab-content">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <HBox spacing="10">
                                    <Button text="Refresh" onAction="#refreshViolations" styleClass="secondary-btn"/>
                                    <Button fx:id="markPaidBtn" text="Mark as Paid" onAction="#handleMarkPaid" styleClass="primary-btn"/>
                                </HBox>
                                <TableView fx:id="violationTable" VBox.vgrow="ALWAYS" styleClass="table-view-vis">
                                    <columns>
                                        <TableColumn fx:id="vlIdCol"     text="ID"          prefWidth="50"/>
                                        <TableColumn fx:id="vlRegCol"    text="Reg. Number" prefWidth="130"/>
                                        <TableColumn fx:id="vlDateCol"   text="Date"        prefWidth="110"/>
                                        <TableColumn fx:id="vlTypeCol"   text="Type"        prefWidth="130"/>
                                        <TableColumn fx:id="vlFineCol"   text="Fine (M)"    prefWidth="100"/>
                                        <TableColumn fx:id="vlStatusCol" text="Status"      prefWidth="100"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </Tab>
                    </TabPane>
                </VBox>
            </Tab>

            <!-- Customers Tab -->
            <Tab text="Customers" fx:id="customersTab">
                <VBox spacing="10" styleClass="tab-content">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <Label text="Customer Registry" styleClass="section-title"/>
                    <HBox spacing="10">
                        <Button text="Refresh" onAction="#refreshCustomers" styleClass="secondary-btn"/>
                        <Button text="+ Add Customer" onAction="#openAddCustomerDialog" styleClass="primary-btn"/>
                        <Button text="Delete" onAction="#handleDeleteCustomer" styleClass="danger-btn"/>
                    </HBox>
                    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" styleClass="table-view-vis">
                        <columns>
                            <TableColumn fx:id="cIdCol"      text="ID"      prefWidth="50"/>
                            <TableColumn fx:id="cNameCol"    text="Name"    prefWidth="160"/>
                            <TableColumn fx:id="cAddressCol" text="Address" prefWidth="200"/>
                            <TableColumn fx:id="cPhoneCol"   text="Phone"   prefWidth="130"/>
                            <TableColumn fx:id="cEmailCol"   text="Email"   prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <!-- Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="5" right="15" bottom="5" left="15"/></padding>
            <Label fx:id="statusLabel" text="Ready" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dateTimeLabel" text="" styleClass="status-label"/>
        </HBox>
    </bottom>
</BorderPane>
