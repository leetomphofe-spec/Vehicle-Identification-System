<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vis.controller.AddCustomerController"
      spacing="15" styleClass="root-pane"
      prefWidth="420" prefHeight="340">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Add New Customer" styleClass="section-title"/>

    <GridPane hgap="10" vgap="12">
        <Label text="Full Name" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="nameField" promptText="Full Name"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220" styleClass="text-field-vis"/>

        <Label text="Address" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="addressField" promptText="Address"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field-vis"/>

        <Label text="Phone" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="phoneField" promptText="+266 5..."
                   GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field-vis"/>

        <Label text="Email" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="emailField" promptText="email@example.com"
                   GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="text-field-vis"/>
    </GridPane>

    <Label fx:id="errorLabel" text="" styleClass="error-label"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-btn"/>
        <Button fx:id="saveBtn" text="Save Customer" onAction="#handleSave" styleClass="primary-btn"/>
    </HBox>
</VBox>