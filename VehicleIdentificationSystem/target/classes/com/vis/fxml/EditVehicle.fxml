<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vis.controller.EditVehicleController"
      spacing="15" styleClass="root-pane"
      prefWidth="550" prefHeight="650">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Edit Vehicle" styleClass="section-title"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <GridPane hgap="10" vgap="12">
            <Label text="Registration No.*" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="regField" promptText="A 123 LS"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" styleClass="text-field-vis"/>

            <Label text="Make*" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="makeField" promptText="Toyota"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Model*" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="modelField" promptText="Corolla"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Year*" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="yearField" promptText="2020"
                       GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Owner ID*" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="ownerIdField" promptText="Customer ID"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Color" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="colorField" promptText="Red, Blue, Silver"
                       GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Status" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="field-label"/>
            <ComboBox fx:id="statusCombo" GridPane.rowIndex="6" GridPane.columnIndex="1"
                      prefWidth="250" styleClass="combo-vis"/>

            <Label text="Engine" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="engineField" promptText="2.0L 4-cylinder"
                       GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Transmission" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="transmissionField" promptText="6-Speed Manual"
                       GridPane.rowIndex="8" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Fuel Type" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="fuelTypeField" promptText="Petrol, Diesel, Hybrid"
                       GridPane.rowIndex="9" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Mileage (km)" GridPane.rowIndex="10" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="mileageField" promptText="45000"
                       GridPane.rowIndex="10" GridPane.columnIndex="1" styleClass="text-field-vis"/>

            <Label text="Description" GridPane.rowIndex="11" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextArea fx:id="descriptionArea" promptText="Vehicle description"
                      GridPane.rowIndex="11" GridPane.columnIndex="1" prefHeight="80" styleClass="text-field-vis"/>
        </GridPane>
    </ScrollPane>

    <Label fx:id="errorLabel" text="" styleClass="error-label"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-btn"/>
        <Button fx:id="saveBtn" text="Update Vehicle" onAction="#handleSave" styleClass="primary-btn"/>
    </HBox>
</VBox>