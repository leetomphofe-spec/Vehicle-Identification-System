<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vis.controller.AddViolationController"
      spacing="15" styleClass="root-pane"
      prefWidth="450" prefHeight="400">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Add New Violation" styleClass="section-title"/>

    <GridPane hgap="10" vgap="12">
        <Label text="Vehicle ID" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="vehicleIdField" promptText="Enter Vehicle ID"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220" styleClass="text-field-vis"/>

        <Label text="Registration Number" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="regNumberField" promptText="e.g. A 123 LS"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field-vis"/>

        <Label text="Violation Date" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="dateField" promptText="YYYY-MM-DD"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field-vis"/>

        <Label text="Violation Type" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
        <ComboBox fx:id="typeCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"
                  prefWidth="220" styleClass="combo-vis"/>

        <Label text="Fine Amount (M)" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="fineField" promptText="e.g. 500.00"
                   GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="text-field-vis"/>

        <Label text="Description" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextArea fx:id="descField" promptText="Violation details..."
                  GridPane.rowIndex="5" GridPane.columnIndex="1" prefHeight="60" styleClass="text-field-vis"/>
    </GridPane>

    <Label fx:id="errorLabel" text="" styleClass="error-label"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-btn"/>
        <Button text="Save Violation" onAction="#handleSave" styleClass="primary-btn"/>
    </HBox>
</VBox>